# Postgres connection string (Neon, via the Vercel Marketplace integration).
# Run `vercel env pull .env.local` to fill this in automatically.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# SheetDB endpoints backing the QR verification pages (/verify/valuation/[token]
# and /verify/offer/[token]). These read from the existing Google Sheet +
# Apps Script workflow — see lib/verify.server.ts.
SHEETDB_VALUATION_URL="https://sheetdb.io/api/v1/xxxxxxxxxxxxx"
SHEETDB_OFFER_URL="https://sheetdb.io/api/v1/xxxxxxxxxxxxx"
